# Host de PostgreSQL al que se conecta el backend.
DB_HOST=localhost
# Puerto expuesto por PostgreSQL en Docker.
DB_PORT=5433
# Nombre de la base de datos.
DB_NAME=pauseflow
# Usuario de PostgreSQL.
DB_USER=postgres
# Contraseña de PostgreSQL.
DB_PASSWORD=postgres
# Puerto en el que escucha el backend.
PORT=3000
# Clave usada para cifrar datos sensibles como teléfono y contraseña.
ENCRYPTION_KEY=pauseflow-2026-secure-key-123